MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=resume_analyzer
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_MB=10

# Semantic embeddings run locally. First run downloads the model weights.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Required for generative AI resume feedback and mock interviews.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Real job listings from Adzuna (get credentials at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
